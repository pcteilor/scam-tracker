# Copie para .env.local e preencha com os valores do seu projeto Neon.
# Nunca commite .env.local nem cole credenciais reais no repositório.

# Connection string pooled (Recommended for most uses) - uso em runtime
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?connect_timeout=15&sslmode=require"

# Connection string sem pooler - uso em migrations (Prisma)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Hash bcrypt da senha do admin (opcional; pode ser definido via seed ou primeiro login).
# ADMIN_PASSWORD_HASH=""
